<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 백업·기기 이전. #11: 로그인 토큰(DataStore)은 제외 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
